# Copy to .env (gitignored) and fill in the real DEV backend URL for local `npm start`/`npm run
# watch`. Never commit a filled-in .env. There is no local path for the PROD URL — production
# builds only ever happen in CI (see scripts/inject-api-url.js and README.md).

WORKSHOP_API_URL=https://script.google.com/macros/s/REPLACE_WITH_DEV_DEPLOYMENT_ID/exec

# Optional — only needed to test the firebase-page demo's real Auth flow locally against the DEV
# Firebase project. Leave unset and the demo falls back to its own hardcoded demo config.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
