# Local DEV env vars

WORKSHOP_API_URL=https://script.google.com/macros/s/REPLACE_WITH_DEV_DEPLOYMENT_ID/exec

# Firebase config — required to sign in on the /firebase demo page and to reach
# bakery/workshop/admin locally, which now gates on Firebase Auth (Google sign-in)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Web Push VAPID key, for the /fcm-demo test page.
FIREBASE_VAPID_KEY=

# Comma-separated allowlist of Google account emails permitted into bakery/workshop/admin.
# Leave unset (or empty) and every sign-in is rejected — deny-by-default.
ADMIN_ALLOWED_EMAILS=admin@example.com,someone-else@example.com
